# PostgreSQL
POSTGRES_HOST=chart_postgres
POSTGRES_PORT=5432
POSTGRES_USER=chapar
POSTGRES_PASSWORD=
POSTGRES_DB=chapar
POSTGRES_TELEGRAM_DB=chapar_bot
DATABASE_URL=postgresql+asyncpg://chapar:PASSWORD@chart_postgres:5432/chapar

# Redis
REDIS_URL=redis://chart_redis:6379/0
# REDIS_PASSWORD=
APP_NAMESPACE=chapar
REDIS_EXPIRE_TIME=36000
REDIS_CHART_EXPIRE=3600
REDIS_CURRENCY_EXPIRE=600
REDIS_ANALYSIS_EXPIRE=3600
TRENDING_CACHE_TTL=46100

# OpenRouter / OpenAI-compatible LLM
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY_CHAT=
LLM_MODEL=openai/gpt-4o-mini
LLM_ANALYSIS_MODEL=openai/gpt-4o-mini
LLM_NEWS_MODEL=openai/gpt-4o-mini
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_RESPONSE_LANGUAGE=Persian
LLM_MAX_TOKENS=10000
LLM_TIMEOUT=30
LLM_MAX_HISTORY_MESSAGES=20
LLM_SYSTEM_PROMPT=You are a helpful financial assistant. Respond in Persian unless the user asks for another language.
LLM_HTTP_REFERER=
LLM_APP_NAME=Chapar

